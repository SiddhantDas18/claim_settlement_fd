# Copy to .env (cp .env.example .env). Values here are public: they are built into the browser app, so never put secrets in this file.

# Address of the backend API (Claim_Settlement_BD). The browser calls it directly, so the backend's CORS_ORIGINS
# must include this app's address (default http://localhost:5173).
# Leave it empty (VITE_API_URL=) to use the dev server's proxy instead (see vite.config.ts, BACKEND_URL).
VITE_API_URL=http://localhost:8000
